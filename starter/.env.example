# Copy to .env for local work. Never commit .env (it is git-ignored).
#
# PUBLIC_ variables are compiled into the browser bundle. Anyone can read them.
# Only put values here that are safe to publish.
#
# Cloudflare Turnstile SITE key (public). The value below is Cloudflare's dummy
# test key: it always passes and is fine for local dev and CI. Replace it with
# your real site key before launch (Cloudflare dashboard > Turnstile).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ---- SERVER SECRETS ----
# Set these ONLY in the host's dashboard (Cloudflare Pages > Settings > Environment variables).
# They are read by functions/api/contact.ts at request time and never reach the browser.
# Do not prefix them with PUBLIC_.
#
# Turnstile SECRET key (server only).
TURNSTILE_SECRET=
# Where contact submissions are forwarded (n8n, Make, Zapier, GHL inbound webhook, your own endpoint).
CONTACT_WEBHOOK_URL=
