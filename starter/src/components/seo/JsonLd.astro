---
/*
  Renders schema.org objects safely. "<" is escaped so a value like "</script>" cannot
  break out of the tag. type="application/ld+json" is a data block, so the CSP
  (script-src 'self') does not block or need to allow it.
*/
import type { JsonLdNode } from '@/lib/schema';

interface Props {
  data: JsonLdNode | JsonLdNode[];
}
const { data } = Astro.props;
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<script is:inline type="application/ld+json" set:html={json} />
