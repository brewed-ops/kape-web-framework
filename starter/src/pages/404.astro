---
import Base from '@/layouts/Base.astro';
import PageHeading from '@/components/ui/PageHeading.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import { pages } from '@/content/pages';

const p = pages.notFound;
---

<Base title={p.title} description={p.description} noindex>
  <PageHeading title={p.h1} lead={p.lead} />
  <Container class="pt-8 pb-[var(--section-y)]">
    <Button href="/" arrow>{p.back}</Button>
  </Container>
</Base>
