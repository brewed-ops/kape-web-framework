---
/* Pricing. The featured tier is a flat accent-filled panel; the others are hairline panels. */
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { primaryAction, siteType } from '@/config/site';
import { pricing } from '@/content/pricing';
const href = primaryAction[siteType].href;
---

<Section feature="pricing" heading={pricing.heading} lead={pricing.lead}>
  <div class="grid gap-4 md:grid-cols-3 md:items-stretch">
    {
      pricing.tiers.map((t) => (
        <article class={`flex flex-col rounded-lg p-8 ${t.featured ? 'bg-accent text-on-accent' : 'border border-line-strong bg-surface-1'}`}>
          <h3 class="text-xl">{t.name}</h3>
          <p class={`mt-1 ${t.featured ? 'text-on-accent' : 'text-muted'}`}>{t.text}</p>
          <p class="mt-8 flex items-baseline gap-2">
            <span class="text-3xl font-semibold tracking-tight">{t.price}</span>
            <span class={`label ${t.featured ? '!text-on-accent' : ''}`}>{t.unit}</span>
          </p>
          <ul class="mt-8 flex-1 space-y-3 text-sm">
            {t.features.map((f) => (
              <li class="flex gap-3">
                <Icon name="check" size={18} class="mt-0.5 shrink-0" />
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <div class="mt-10">
            {t.featured ? (
              <a href={href} class="inline-flex min-h-12 w-full items-center justify-center rounded-md bg-ground px-6 font-medium text-fg">{t.cta}</a>
            ) : (
              <Button href={href} variant="secondary" class="w-full">{t.cta}</Button>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Section>
