---
/* Footer. variant="minimal" (funnels): name, legal links and copyright only. */
import Container from '@/components/ui/Container.astro';
import { site, siteType, nav } from '@/config/site';
import { footer } from '@/content/footer';

interface Props {
  variant?: string;
}
const { variant } = Astro.props;
const minimal = variant === 'minimal';
const year = new Date().getFullYear();
const a = site.address;
---

<footer data-feature="footer" class="border-t border-line bg-surface-1 py-12 md:py-16">
  <Container>
    {
      minimal ? (
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <p class="text-sm text-muted">
            &copy; {year} {site.legalName}. {footer.rights}
          </p>
          <ul class="flex gap-6 text-sm text-muted">
            {footer.legalLinks.map((l) => (
              <li>
                <a href={l.href} class="hover:text-fg">{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
          <div>
            <p class="text-lg font-semibold">{site.name}</p>
            <p class="mt-3 max-w-xs text-sm text-muted">{footer.blurb}</p>
          </div>
          <div>
            <h2 class="label mb-4">{footer.menuHeading}</h2>
            <ul class="space-y-2 text-sm">
              {nav[siteType].map((l) => (
                <li><a href={l.href} class="text-muted hover:text-fg">{l.label}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <h2 class="label mb-4">{footer.contactHeading}</h2>
            <address class="space-y-2 text-sm not-italic text-muted">
              {a && <p>{a.street}<br />{a.city}, {a.region} {a.postalCode}</p>}
              <p><a href={`tel:${site.phone.replace(/\s/g, '')}`} class="hover:text-fg">{site.phoneDisplay}</a></p>
              <p><a href={`mailto:${site.email}`} class="hover:text-fg">{site.email}</a></p>
            </address>
          </div>
          <div>
            <h2 class="label mb-4">{footer.legalHeading}</h2>
            <ul class="space-y-2 text-sm">
              {footer.legalLinks.map((l) => (
                <li><a href={l.href} class="text-muted hover:text-fg">{l.label}</a></li>
              ))}
            </ul>
            {site.socials.length > 0 && (
              <ul class="mt-6 flex gap-5 text-sm">
                {site.socials.map((s) => (
                  <li><a href={s.href} rel="noopener noreferrer" class="text-muted hover:text-fg">{s.label}</a></li>
                ))}
              </ul>
            )}
          </div>
          <p class="border-t border-line pt-6 text-sm text-muted md:col-span-4">
            &copy; {year} {site.legalName}. {footer.rights}
          </p>
        </div>
      )
    }
  </Container>
</footer>
