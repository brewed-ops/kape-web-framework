---
/* Proof: one large featured quote plus smaller ones. Asymmetric on purpose. */
import Container from '@/components/ui/Container.astro';
import { proof } from '@/content/proof';
---

<section id="proof" data-feature="proof" class="py-[var(--section-y)]">
  <Container>
    <div class="mb-12 flex flex-col gap-2 md:mb-16 md:flex-row md:items-baseline md:justify-between">
      <h2 class="text-3xl">{proof.heading}</h2>
      <p class="label">{proof.rating.value} out of {proof.rating.outOf} from {proof.rating.source}</p>
    </div>
    <div class="grid gap-12 md:grid-cols-[1.5fr_1fr] md:gap-16">
      <figure>
        <blockquote class="text-2xl">&ldquo;{proof.featured.text}&rdquo;</blockquote>
        <figcaption class="mt-6 text-muted">
          <span class="text-fg">{proof.featured.name}</span>, {proof.featured.detail}
        </figcaption>
      </figure>
      <div class="divide-y divide-line border-y border-line">
        {
          proof.others.map((q) => (
            <figure class="py-6">
              <blockquote class="text-lg">&ldquo;{q.text}&rdquo;</blockquote>
              <figcaption class="mt-3 text-sm text-muted">
                <span class="text-fg">{q.name}</span>, {q.detail}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </Container>
</section>
