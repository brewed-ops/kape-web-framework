---
/* FAQ with native <details>: keyboard accessible, zero JS. Also emits FAQPage JSON-LD. */
import Container from '@/components/ui/Container.astro';
import Icon from '@/components/ui/Icon.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { faqPage } from '@/lib/schema';
import { faq } from '@/content/faq';
---

<section id="faq" data-feature="faq" class="py-[var(--section-y)]">
  <JsonLd data={faqPage(faq.items)} />
  <Container class="grid gap-12 md:grid-cols-[1fr_2fr] md:gap-16">
    <h2 class="text-3xl md:sticky md:top-28 md:self-start">{faq.heading}</h2>
    <div class="divide-y divide-line border-y border-line">
      {
        faq.items.map((q) => (
          <details class="group py-5">
            <summary class="flex items-center justify-between gap-6 text-lg font-medium">
              {q.question}
              <Icon name="plus" class="shrink-0 text-muted transition-transform duration-[var(--dur)] ease-spring group-open:rotate-45" />
            </summary>
            <p class="mt-3 max-w-prose text-muted">{q.answer}</p>
          </details>
        ))
      }
    </div>
  </Container>
</section>
